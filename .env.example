# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Mapbox basemap (docs/) --------------------------------------------------
# Publishable (pk.*) token for the CPAL Mapbox style. It is embedded in the
# published page, so it MUST be a public, URL-restricted token — never sk.*.
# Local dev reads it from docs/config.js; the Pages deploy injects it from the
# MAPBOX_TOKEN repo secret. Reuse the pk token the live 2023 page already exposes.
MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Databricks / cpal-data-platform warehouse (join script) -----------------
# CPAL env contract (same variable names as the evictions databricks-api service).
# Preferred auth is the databricks CLI OAuth profile (`databricks auth login`),
# which odbc::databricks() picks up; DATABRICKS_TOKEN (a PAT) is the alternative.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# The SQL warehouse: give the id (HTTP path is derived) or a full path to override.
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# DATABRICKS_TOKEN=dapi...          # only if not using the OAuth CLI profile
# Catalog / schema overrides (defaults are current prod; use dev_* for the dev bundle).
DATABRICKS_CATALOG=silver
DATABRICKS_SCHEMA=silver_tx_dallas_cad_car
DATABRICKS_BRONZE_CATALOG=bronze
DATABRICKS_BRONZE_SCHEMA=bronze_tx_dallas_cad

# --- Water/parks mask sources (build_mask.R) ---------------------------------
# Local paths (preferred: pre-download one at a time) or a single URL each.
MASK_WATER_SRC=data/_mask_src/water.geojson
MASK_PARKS_SRC=data/_mask_src/parks.geojson
